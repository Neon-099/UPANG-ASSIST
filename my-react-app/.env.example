# Leave empty when the frontend and API are served from the same domain.
# For a separately hosted API, set its full API path, e.g.
# VITE_API_BASE_URL=https://api.example.edu/api
VITE_API_BASE_URL=
# Optional Socket.IO origin when the API is hosted separately.
# VITE_SOCKET_URL=https://api.example.edu
VITE_SOCKET_URL=
# Google OAuth Web client ID (public; configure the matching ID on the API too).
VITE_GOOGLE_CLIENT_ID=
